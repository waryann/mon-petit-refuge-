# Clés API et configuration
# Copiez ce fichier vers .env et remplissez les valeurs

# === MOLLIE (Paiement) ===
# Créez un compte sur https://www.mollie.com
# Récupérez votre clé API dans Dashboard > Developers > API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# === EMAIL (Gmail SMTP) ===
# Utilisez un "App Password" Gmail : 
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=monpetitrefuge@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# === ADMIN ===
# Mot de passe pour accéder au dashboard admin
ADMIN_PASSWORD=changeme2026

# === SESSION ===
# Clé secrète pour les sessions Express (changez cette valeur)
SESSION_SECRET=cine-diner-secret-key-change-me

# === APPLICATION ===
# URL de base de l'application (sans / à la fin)
BASE_URL=http://localhost:3000

# Nombre maximum de places disponibles
MAX_PLACES=80

# Port du serveur
PORT=3000
