<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Soirée Ciné-Dîner — Confirmation</title>
  <style>
    /* Email-safe inline styles */
    body {
      margin: 0;
      padding: 0;
      background-color: #0a0a12;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      color: #f5f0e8;
    }
    .email-wrapper {
      max-width: 600px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    .email-card {
      background-color: #16162a;
      border: 1px solid rgba(212, 160, 23, 0.2);
      border-radius: 16px;
      overflow: hidden;
    }
    .email-header {
      background: linear-gradient(135deg, #1a1a2e, #2a2a4e);
      padding: 40px 30px;
      text-align: center;
      border-bottom: 3px solid #d4a017;
    }
    .email-header h1 {
      margin: 0 0 8px;
      font-size: 28px;
      color: #f5f0e8;
      font-weight: 700;
    }
    .email-header p {
      margin: 0;
      color: #d4a017;
      font-size: 18px;
      font-style: italic;
    }
    .email-body {
      padding: 30px;
    }
    .email-greeting {
      font-size: 16px;
      color: #f5f0e8;
      margin-bottom: 20px;
      line-height: 1.6;
    }
    .confirmation-badge {
      display: block;
      text-align: center;
      margin: 24px 0;
      padding: 12px;
      background: rgba(46, 204, 113, 0.1);
      border: 1px solid rgba(46, 204, 113, 0.3);
      border-radius: 10px;
      color: #2ecc71;
      font-weight: 700;
      font-size: 14px;
    }
    .conf-code {
      display: block;
      text-align: center;
      margin: 20px 0;
      padding: 12px 24px;
      background: rgba(212, 160, 23, 0.12);
      border: 1px solid rgba(212, 160, 23, 0.3);
      border-radius: 10px;
      font-family: monospace;
      font-size: 24px;
      font-weight: 700;
      color: #d4a017;
      letter-spacing: 3px;
    }
    .qr-section {
      text-align: center;
      margin: 24px 0;
      padding: 24px;
      background: #ffffff;
      border-radius: 12px;
    }
    .qr-section img {
      max-width: 250px;
      width: 100%;
    }
    .qr-section p {
      margin: 12px 0 0;
      color: #1a1a2e;
      font-size: 13px;
      font-weight: 600;
    }
    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
    }
    .detail-table td {
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 14px;
    }
    .detail-table .label {
      color: rgba(245, 240, 232, 0.5);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding-bottom: 2px;
    }
    .detail-table .value {
      color: #f5f0e8;
      font-weight: 600;
      padding-top: 0;
    }
    .email-footer {
      padding: 24px 30px;
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .email-footer p {
      margin: 0;
      font-size: 12px;
      color: rgba(245, 240, 232, 0.4);
      line-height: 1.6;
    }
    .email-footer a {
      color: #d4a017;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-card">

      <!-- Header -->
      <div class="email-header">
        <h1>🎬 Soirée Ciné-Dîner</h1>
        <p>« La vie est belle »</p>
      </div>

      <!-- Body -->
      <div class="email-body">

        <p class="email-greeting">
          Bonjour <strong><%= registration.prenom %></strong>,<br><br>
          Votre inscription à la <strong>Soirée Ciné-Dîner</strong> est confirmée ! 🎉
        </p>

        <div class="confirmation-badge">
          ✅ Paiement reçu — Inscription validée
        </div>

        <!-- Code de confirmation -->
        <div class="conf-code"><%= registration.confirmation_code %></div>

        <!-- QR Code -->
        <div class="qr-section">
          <img src="cid:qrcode-billet" alt="QR Code — Votre billet d'entrée">
          <p>📱 Présentez ce QR code à l'entrée</p>
        </div>

        <!-- Détails -->
        <table class="detail-table">
          <tr>
            <td class="label" colspan="2">Événement</td>
          </tr>
          <tr>
            <td class="value" colspan="2"><%= eventName %></td>
          </tr>

          <tr>
            <td class="label" colspan="2">Date & Horaire</td>
          </tr>
          <tr>
            <td class="value" colspan="2"><%= eventDate %> · <%= eventTime %></td>
          </tr>

          <tr>
            <td class="label" colspan="2">Lieu</td>
          </tr>
          <tr>
            <td class="value" colspan="2">📍 <%= eventAddress %></td>
          </tr>

          <tr>
            <td class="label" colspan="2">Nom</td>
          </tr>
          <tr>
            <td class="value" colspan="2"><%= registration.prenom %> <%= registration.nom %></td>
          </tr>

          <tr>
            <td class="label" colspan="2">Nombre de places</td>
          </tr>
          <tr>
            <td class="value" colspan="2"><%= registration.nombre_places %> place<%= registration.nombre_places > 1 ? 's' : '' %></td>
          </tr>

          <tr>
            <td class="label" colspan="2">Montant payé</td>
          </tr>
          <tr>
            <td class="value" colspan="2"><%= registration.total_amount %>€</td>
          </tr>
        </table>

      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p>
          Des questions ? Contactez-nous :<br>
          <a href="mailto:monpetitrefuge@gmail.com">monpetitrefuge@gmail.com</a>
        </p>
        <p style="margin-top: 16px;">
          © 2026 Soirée Ciné-Dîner · La vie est belle
        </p>
      </div>

    </div>
  </div>
</body>
</html>
