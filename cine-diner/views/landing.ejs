<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Soirée Ciné-Dîner — Projection du film 'La vie est belle' suivie d'un repas solidaire. Samedi 26 septembre, 18h-22h à Sint-Pieters-Leeuw. Réservez vos places en ligne !">
  <meta name="theme-color" content="#0a0a12">
  <title>Soirée Ciné-Dîner — La vie est belle</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- ===== HERO SECTION ===== -->
  <section class="hero" id="hero">
    <div class="hero__background">
      <img src="/images/hero-bg.png" alt="" class="bg-blur">
      <img src="/images/hero-bg.png" alt="Soirée Ciné-Dîner ambiance" loading="eager" data-speed="auto" class="bg-sharp">
    </div>
    <div id="tsparticles"></div>
    <div class="hero__overlay"></div>

    <div class="hero__content">
      <div class="hero__text-content">
        <span class="hero__badge gsap-hero-reveal">🎬 Projection caritative</span>
        <h1 class="hero__title gsap-hero-title">Soirée Ciné-Dîner</h1>
        <p class="hero__subtitle gsap-hero-reveal">« La vie est belle »</p>

        <div class="hero__flyer-info gsap-hero-reveal">
          <div class="flyer-row">
            <div class="flyer-box">
              <span class="flyer-icon">📅</span>
              <span>Samedi 26 septembre</span>
            </div>
            <div class="flyer-box">
              <span class="flyer-icon">🕒</span>
              <span>18h00 - 22h00</span>
            </div>
          </div>
          
          <div class="flyer-box flyer-box--full">
            <span class="flyer-icon">📍</span>
            <span>Brusselbaan 140, 1600 Sint-Pieters-Leeuw</span>
          </div>

          <div class="flyer-row flyer-prices">
            <div class="flyer-price-box">
              <strong class="gold-text">50 €</strong>
              <span>Formule Complète<br><small>(Avec repas)</small></span>
            </div>
            <div class="flyer-price-divider"></div>
            <div class="flyer-price-box">
              <strong class="gold-text">25 €</strong>
              <span>Formule Ciné<br><small>(Sans repas)</small></span>
            </div>
          </div>

          <div class="flyer-box flyer-box--full flyer-box--small flyer-box--contact">
            <span class="flyer-icon">✉️</span>
            <span>Info : monptitrefuge@gmail.com</span>
          </div>
        </div>

        <div class="hero__cta gsap-hero-reveal">
          <% if (soldOut) { %>
            <div class="places-badge sold-out">Complet — Plus de places disponibles</div>
          <% } else { %>
            <a href="#prix" class="btn btn--primary" id="cta-register">
              Réserver ma place
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </section>
  </section>

  <!-- ===== DESCRIPTION ===== -->
  <section class="description-section" id="description">
    <div class="container">
      <div class="description-card gsap-card">
        <p>
          L'ASBL <strong>Mon P'tit Refuge</strong> vous convie à une soirée unique mêlant <strong>cinéma et gastronomie</strong>.
          Assistez à la projection du magnifique film <em>« La vie est belle »</em> dans une ambiance chaleureuse et conviviale,
          et soutenez le projet de construction d'une maison de quartier à Maluku.
        </p>
        <p>
          Nous aurons l'honneur d'accueillir <strong>Nsona Mvuemba</strong>, petite-fille du légendaire
          <strong>Papa Wemba</strong>, en tant qu'invitée d'honneur de cette soirée exceptionnelle.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== PRICE & CTA ===== -->
  <section class="price-section" id="prix">
    <div class="container">
      <h2 class="section-title gsap-section-title">Réservez vos <span>places</span></h2>

      <div class="pricing-grid">
        <!-- Option 1: 25€ -->
        <div class="price-card gsap-card">
          <div class="price-amount">25<span>€</span></div>
          <div class="price-label">par personne</div>
          <h3 class="price-name">Formule Ciné</h3>
          <ul class="price-includes">
            <li>Projection du film « La vie est belle »</li>
            <li>Soutien au projet de Maluku</li>
            <li>Rencontre avec Nsona Mvuemba</li>
            <li class="excluded">Repas non inclus</li>
          </ul>
          <% if (!soldOut) { %>
            <a href="/inscription?type=25" class="btn btn--secondary btn--full">S'inscrire (25€)</a>
          <% } else { %>
            <button class="btn btn--secondary btn--full" disabled>Complet</button>
          <% } %>
        </div>

        <!-- Option 2: 50€ -->
        <div class="price-card featured gsap-card">
          
          <div class="price-amount">50<span>€</span></div>
          <div class="price-label">par personne</div>
          <h3 class="price-name">Formule Complète</h3>
          <ul class="price-includes">
            <li>Projection du film « La vie est belle »</li>
            <li>Soutien au projet de Maluku</li>
            <li>Rencontre avec Nsona Mvuemba</li>
            <li><strong>Repas complet (Poulet à la Moambe)</strong></li>
          </ul>
          <% if (!soldOut) { %>
            <a href="/inscription?type=50" class="btn btn--primary btn--full">S'inscrire (50€)</a>
          <% } else { %>
            <button class="btn btn--secondary btn--full" disabled>Complet</button>
          <% } %>
        </div>
      </div>
      <% if (placesRemaining > 0) { %>
        <p class="places-left-text gsap-card" style="text-align: center; margin-top: var(--space-lg); color: var(--text-muted);">Il ne reste que <strong><%= placesRemaining %> places</strong> disponibles au total.</p>
      <% } %>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer" id="contact">
    <div class="container">
      <div class="footer__contact">
        <a href="mailto:monpetitrefuge@gmail.com">📧 monpetitrefuge@gmail.com</a>
      </div>
      <p class="footer__copy">
        © 2026 Soirée Ciné-Dîner · La vie est belle · Tous droits réservés
      </p>
    </div>
  </footer>

  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <script>alert('<%= errorMessage %>');</script>
  <% } %>

  <script src="/js/main.js"></script>
</body>
</html>
