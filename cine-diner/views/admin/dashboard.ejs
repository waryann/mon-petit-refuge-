<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a12">
  <title>Admin — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="admin-page">
    <div class="container">

      <!-- Header -->
      <div class="admin-header">
        <h1>📋 Tableau de bord</h1>
        <div class="admin-header__actions">
          <a href="/admin/export/csv" class="btn btn--secondary btn--small">📥 Export CSV</a>
          <a href="/" class="btn btn--secondary btn--small" target="_blank">🌐 Voir le site</a>
          <a href="/admin/logout" class="btn btn--secondary btn--small">🚪 Déconnexion</a>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card__value"><%= stats.totalRegistrations %></div>
          <div class="stat-card__label">Inscriptions</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value"><%= stats.totalPlaces %> / <%= stats.maxPlaces %></div>
          <div class="stat-card__label">Places vendues</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value"><%= stats.placesRemaining %></div>
          <div class="stat-card__label">Places restantes</div>
        </div>
        <div class="stat-card">
          <div class="stat-card__value"><%= stats.totalRevenue %>€</div>
          <div class="stat-card__label">Recettes</div>
        </div>
      </div>

      <% if (stats.pendingCount > 0) { %>
        <div class="form-error" style="background: rgba(243, 156, 18, 0.1); border-color: rgba(243, 156, 18, 0.3); color: var(--color-warning);">
          ⚠️ <%= stats.pendingCount %> paiement(s) en attente
        </div>
      <% } %>

      <!-- Filter -->
      <div class="filter-bar">
        <label for="status-filter">Filtrer par statut :</label>
        <select id="status-filter" onchange="window.location.href='/admin/dashboard?status=' + this.value">
          <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>Tous</option>
          <option value="paid" <%= statusFilter === 'paid' ? 'selected' : '' %>>✅ Payé</option>
          <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>⏳ En attente</option>
          <option value="failed" <%= statusFilter === 'failed' ? 'selected' : '' %>>❌ Échoué</option>
        </select>
      </div>

      
      <!-- Vérificateur de billets -->
      <div class="stats-card" style="margin-top: 20px; background: rgba(255,255,255,0.05); border: 1px solid var(--accent-gold); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px;">
        <h3 style="color: var(--accent-gold); margin-bottom: 15px;">Vérificateur de billets à l'entrée</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px;">Entrez le code présent sur le billet ou scannez le QR code.</p>
        <div style="display: flex; gap: 10px; width: 100%; max-width: 400px;">
          <input type="text" id="ticketCode" placeholder="Ex: A7B2C" style="flex: 1; padding: 10px; border-radius: 4px; border: 1px solid #333; background: #222; color: white;">
          <button onclick="checkTicket()" class="btn btn--primary">Vérifier</button>
        </div>
        <div id="ticketResult" style="margin-top: 15px; font-weight: bold; font-size: 1.1rem; padding: 10px; border-radius: 5px; width: 100%; max-width: 400px; text-align: center; display: none;"></div>
      </div>
      
      <script>
      function checkTicket() {
        const code = document.getElementById('ticketCode').value.trim();
        const resultDiv = document.getElementById('ticketResult');
        if(!code) return;
        
        fetch('/admin/verify/' + code)
          .then(res => res.json())
          .then(data => {
            resultDiv.style.display = 'block';
            if(data.registration) {
              const r = data.registration;
              if(r.payment_status === 'paid') {
                resultDiv.style.background = 'rgba(46, 204, 113, 0.2)';
                resultDiv.style.color = '#2ecc71';
                resultDiv.innerHTML = `✅ Billet valide !<br><small>${r.prenom} ${r.nom} (${r.nombre_places} place)</small>`;
              } else {
                resultDiv.style.background = 'rgba(241, 196, 15, 0.2)';
                resultDiv.style.color = '#f1c40f';
                resultDiv.innerHTML = `⚠️ Billet en attente de paiement !<br><small>${r.prenom} ${r.nom}</small>`;
              }
            } else {
              resultDiv.style.background = 'rgba(231, 76, 60, 0.2)';
              resultDiv.style.color = '#e74c3c';
              resultDiv.innerHTML = `❌ Billet introuvable ! Code invalide.`;
            }
          })
          .catch(err => alert("Erreur de connexion."));
      }
      </script>


      <!-- Table -->
      <% if (registrations.length > 0) { %>
        <div class="table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Places</th>
                <th>Montant</th>
                <th>Régime</th>
                <th>Statut</th>
                <th>Code</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% registrations.forEach((r, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td style="color: var(--color-cream); font-weight: 600;"><%= r.nom %></td>
                  <td style="color: var(--color-cream);"><%= r.prenom %></td>
                  <td><a href="mailto:<%= r.email %>" style="color: var(--color-gold);"><%= r.email %></a></td>
                  <td><%= r.telephone %></td>
                  <td style="text-align: center; font-weight: 700; color: var(--color-cream);"><%= r.nombre_places %></td>
                  <td style="font-weight: 600; color: var(--color-cream);"><%= r.total_amount %>€</td>
                  <td><%= r.regime_alimentaire || '—' %></td>
                  <td>
                    <span class="status-badge <%= r.payment_status %>">
                      <%= r.payment_status === 'paid' ? '✅ Payé' : r.payment_status === 'pending' ? '⏳ Attente' : '❌ Échoué' %>
                    </span>
                  </td>
                  <td style="font-family: monospace; font-size: 0.75rem; color: var(--color-gold);"><%= r.confirmation_code %></td>
                  <td style="font-size: 0.75rem;"><%= new Date(r.created_at).toLocaleDateString('fr-BE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state__icon">📭</div>
          <p>Aucune inscription<%= statusFilter !== 'all' ? ' avec ce statut' : '' %> pour le moment.</p>
        </div>
      <% } %>

    </div>
  </div>

</body>
</html>
